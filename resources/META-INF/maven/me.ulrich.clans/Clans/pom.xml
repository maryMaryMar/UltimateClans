<?xml version="1.0" encoding="UTF-8"?>
<project
	xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<!-- ========================= -->
	<!-- 📦 PROJECT -->
	<!-- ========================= -->
	<groupId>me.ulrich.clans</groupId>
	<artifactId>Clans</artifactId>
	<version>9.3.1</version>
	<name>UltimateClans</name>
	<!-- ========================= -->
	<!-- ⚙️ PROPERTIES -->
	<!-- ========================= -->
	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<java.version>17</java.version>
		<!-- default -->
	</properties>
	<!-- ========================= -->
	<!-- 🔥 PROFILES -->
	<!-- ========================= -->
	<profiles>
		<!-- DEFAULT -->
		<profile>
			<id>java17</id>
			<activation>
				<activeByDefault>true</activeByDefault>
			</activation>
			<properties>
				<java.version>17</java.version>
			</properties>
		</profile>
		<!-- MODERN-->
		<profile>
			<id>java25</id>
			<properties>
				<java.version>25</java.version>
			</properties>
		</profile>
	</profiles>
	<!-- ========================= -->
	<!-- 🔧 BUILD -->
	<!-- ========================= -->
	<build>
		<plugins>
			<!-- COMPILER -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.13.0</version>
				<configuration>
					<release>${java.version}</release>
					<encoding>${project.build.sourceEncoding}</encoding>
					<failOnError>true</failOnError>
				</configuration>
			</plugin>
			<!-- SHADE -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-shade-plugin</artifactId>
				<version>3.6.2</version>
				<executions>
					<execution>
						<phase>package</phase>
						<goals>
							<goal>shade</goal>
						</goals>
						<configuration>
							<relocations>
								<relocation>
									<pattern>me.ulrich.econfig</pattern>
									<shadedPattern>me.ulrich.clans.library.enumconfig</shadedPattern>
								</relocation>
								<relocation>
									<pattern>dev.triumphteam.gui</pattern>
									<shadedPattern>me.ulrich.clans.library.gui</shadedPattern>
								</relocation>
								<relocation>
									<pattern>net.kyori</pattern>
									<shadedPattern>me.ulrich.clans.library.kyori</shadedPattern>
								</relocation>
								<relocation>
									<pattern>com.github.retrooper</pattern>
									<shadedPattern>me.ulrich.clans.library</shadedPattern>
								</relocation>
								<relocation>
									<pattern>io.github.retrooper</pattern>
									<shadedPattern>me.ulrich.clans.library</shadedPattern>
								</relocation>
								<relocation>
									<pattern>com.zaxxer.hikari</pattern>
									<shadedPattern>me.ulrich.clans.library.hikari</shadedPattern>
								</relocation>
								<relocation>
									<pattern>com.udojava</pattern>
									<shadedPattern>me.ulrich.clans.library.udojava</shadedPattern>
								</relocation>
			
								<relocation>
									<pattern>com.github.Anon8281.universalScheduler</pattern>
									<shadedPattern>me.ulrich.clans.library.universalScheduler</shadedPattern>
								</relocation>
								<relocation>
									<pattern>de.tr7zw.changeme.nbtapi</pattern>
									<shadedPattern>me.ulrich.clans.library.nbtapi</shadedPattern>
								</relocation>
								<relocation>
									<pattern>kotlin</pattern>
									<shadedPattern>me.ulrich.clans.library.kotlin</shadedPattern>
								</relocation>
								<relocation>
									<pattern>io.papermc.lib</pattern>
									<shadedPattern>me.ulrich.clans.library.paperlib</shadedPattern>
								</relocation>
								<relocation>
									<pattern>net.megavex.scoreboardlibrary</pattern>
									<shadedPattern>me.ulrich.clans.library.scoreboardlibrary</shadedPattern>
								</relocation>
								<relocation>
									<pattern>com.alessiodp.libby</pattern>
									<shadedPattern>me.ulrich.clans.library.libby</shadedPattern>
								</relocation>
								<relocation>
									<pattern>com.github.fierioziy.particlenativeapi</pattern>
									<shadedPattern>me.ulrich.clans.library.particlenativeapi</shadedPattern>
								</relocation>
<relocation>
    <pattern>net.wesjd.anvilgui</pattern>
    <shadedPattern>me.ulrich.clans.library.anvilgui</shadedPattern>
</relocation>
							</relocations>
<filters>
    <filter>
        <artifact>net.wesjd:anvilgui</artifact>
        <excludes>
            <exclude>net/wesjd/anvilgui/version/Wrapper1_7*</exclude>
            <exclude>net/wesjd/anvilgui/version/Wrapper1_8*</exclude>
            <exclude>net/wesjd/anvilgui/version/Wrapper1_9*</exclude>
            <exclude>net/wesjd/anvilgui/version/Wrapper1_10*</exclude>
            <exclude>net/wesjd/anvilgui/version/Wrapper1_11*</exclude>
            <exclude>net/wesjd/anvilgui/version/Wrapper1_12*</exclude>
            <exclude>net/wesjd/anvilgui/version/Wrapper1_13*</exclude>
            <exclude>net/wesjd/anvilgui/version/Wrapper1_14*</exclude>
            <exclude>net/wesjd/anvilgui/version/Wrapper1_15*</exclude>
            <exclude>net/wesjd/anvilgui/version/Wrapper1_16*</exclude>
            <exclude>net/wesjd/anvilgui/version/Wrapper1_17*</exclude>
        </excludes>
    </filter>
</filters>
							<transformers>
								<transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
									<mainClass>me.ulrich.clans.Clans</mainClass>
								</transformer>
							</transformers>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
<!-- RESOURCES -->
		<resources>
			<!-- 1. Mantém o seu original: Copia e filtra YML e NBT -->
			<resource>
				<directory>src/main/resources</directory>
				<filtering>true</filtering>
				<includes>
					<include>**/*.yml</include>
					<include>**/*.nbt</include>
				</includes>
			</resource>

			<!-- 2. Regra nova: Copia os arquivos .jar de forma bruta (sem filtrar) -->
			<resource>
				<directory>src/main/resources</directory>
				<filtering>false</filtering>
				<includes>
					<include>**/*.jar</include>
				</includes>
			</resource>
		</resources>
	</build>
